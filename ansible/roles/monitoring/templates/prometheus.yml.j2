# roles/monitoring/templates/prometheus.yml.j2
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'jenkins'
    static_configs:
      - targets: ['{{ hostvars[groups["jenkins"][0]]["ansible_host"] }}:9100']

  - job_name: 'tools'
    static_configs:
      - targets: ['{{ hostvars[groups["tools"][0]]["ansible_host"] }}:9100']

  - job_name: 'k8s-master'
    static_configs:
      - targets: ['{{ hostvars[groups["k8s_master"][0]]["ansible_host"] }}:9100']

  - job_name: 'k8s-workers'
    static_configs:
      - targets:
{% for host in groups['k8s_workers'] %}
          - '{{ hostvars[host]["ansible_host"] }}:9100'
{% endfor %}